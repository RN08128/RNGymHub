# ==========================================
# RNGymHub - (.env)
# ==========================================
# Renomeie ou copie este arquivo para .env antes de executar a aplicação:
# cp .env.example .env

# Porta do servidor Fastify (Padrão: 3000)
PORT=3000

# String de conexão do banco de dados PostgreSQL (Ex: Neon DB)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Chave secreta para assinatura dos tokens JWT de autenticação
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# ==========================================
# Configurações do Nodemailer (Envio de E-mails)
# ==========================================
# Servidor SMTP (Ex: smtp.gmail.com, smtp.mailtrap.io, etc.)
SMTP_HOST=smtp.gmail.com

# Porta SMTP (Ex: 587 para STARTTLS ou 465 para SSL)
SMTP_PORT=587

# Usuário e senha do serviço de e-mail
# Dica para Gmail: Use uma "Senha de App" gerada na sua conta do Google
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua_senha_de_app_aqui

# Endereço e nome de exibição do remetente
EMAIL_FROM="RNGymHub <seu-email@gmail.com>"